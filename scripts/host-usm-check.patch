+namespace {
+// STRATA_MPLE_TAP: the GPU's own read of a mapped host buffer, so a tap can compare the device's view with the
+// host's. uncached=1 issues the same L1+L3-bypass load copy_from_mapped uses; 0 is a plain load.
+__dpct_inline__ void mapped_peek_kernel(float *__restrict__ dst, const float *__restrict__ src, int64_t n,
+                                        int uncached) {
+    auto item_ct1 = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    const int64_t i = (int64_t) item_ct1.get_group(2) * item_ct1.get_local_range(2) +
+                      item_ct1.get_local_id(2);
+    if (i < n) dst[i] = uncached ? strata::sys_load_mapped(src + i) : src[i];
+}
+__dpct_inline__ void mapped_probe_kernel(float *__restrict__ dst, const float *__restrict__ src, int64_t pages,
+                                         int64_t per, int uncached) {
+    auto item_ct1 = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    const int64_t i = (int64_t) item_ct1.get_group(2) * item_ct1.get_local_range(2) +
+                      item_ct1.get_local_id(2);
+    if (i < pages * per) {
+        const float* s = src + (i / per) * 1024 + (i % per);
+        dst[i] = uncached ? strata::sys_load_mapped(s) : *s;
+    }
+}
+}  // namespace
+
+void mapped_peek(float* dst, const float* src, int64_t n, int uncached, void* stream) {
+    if (n <= 0) return;
+    const int blocks = (int) ((n + 255) / 256);
+    {
+        auto exp_props = sycl::ext::oneapi::experimental::properties{
+            sycl::ext::oneapi::experimental::use_root_sync};
+        strata::q_of(stream)
+            ->parallel_for<dpct_kernel_name<class mapped_peek_kernel_3f7a2b>>(
+                sycl::nd_range<3>(sycl::range(1, 1, blocks) * sycl::range(1, 1, 256),
+                                  sycl::range(1, 1, 256)),
+                exp_props,
+                [=](sycl::nd_item<3> item_ct1) { mapped_peek_kernel(dst, src, n, uncached); });
+    }
+    check_launch("mapped_peek");
+}
+
+void mapped_probe(float* dst, const float* src, int64_t pages, int64_t per, int uncached, void* stream) {
+    const int64_t n = pages * per;
+    if (n <= 0) return;
+    const int blocks = (int) ((n + 255) / 256);
+    {
+        auto exp_props = sycl::ext::oneapi::experimental::properties{
+            sycl::ext::oneapi::experimental::use_root_sync};
+        strata::q_of(stream)
+            ->parallel_for<dpct_kernel_name<class mapped_probe_kernel_8c1e5d>>(
+                sycl::nd_range<3>(sycl::range(1, 1, blocks) * sycl::range(1, 1, 256),
+                                  sycl::range(1, 1, 256)),
+                exp_props,
+                [=](sycl::nd_item<3> item_ct1) { mapped_probe_kernel(dst, src, pages, per, uncached); });
+    }
+    check_launch("mapped_probe");
+}
